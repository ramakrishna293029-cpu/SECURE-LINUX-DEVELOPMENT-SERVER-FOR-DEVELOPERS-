# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# Operating system artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# Temporary logs & disk backups
*.log
/var/log/
/var/backups/
/var/lvm_disks/
*.img
*.vdi
*.iso

# Secret & authentication exclusions
.env
.env.*
*.key
*.pem
id_ed25519
id_rsa
authorized_keys
*.token

# Scratch & reference build previews
docs/pdf_previews/
docs/ref_images/

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
